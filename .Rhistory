legend.text = element_text(size=14,face = "bold",color="black"),legend.title=element_text(size=18,face="bold",color="black"),
legend.position = c(0.8,0.2),text = element_text(size=18,face = "bold",color="black"))
#Ravarani Test Set
rmyrocTsFm=roc(TsFmPredict[TsFmPredict$publication=="ravarani",]$ADpos, TsFmPredict[TsFmPredict$publication=="ravarani",]$Probability_Class_1)
rmyrocTsNm=roc(TsNmPredict[TsNmPredict$publication=="ravarani",]$ADpos, TsNmPredict[TsNmPredict$publication=="ravarani",]$Probability_Class_1)
rmyrocTsRm=roc(TsRmPredict[TsRmPredict$publication=="ravarani",]$ADpos, TsRmPredict[TsRmPredict$publication=="ravarani",]$Probability_Class_1)
RavTsDF=data.frame(Specificity=rmyrocTsFm$specificities,Sensitivity=rmyrocTsFm$sensitivities,Model="FM")
RavTsDF=rbind(RavTsDF,data.frame(Specificity=rmyrocTsNm$specificities,Sensitivity=rmyrocTsNm$sensitivities,Model="NM"))
RavTsDF=rbind(RavTsDF,data.frame(Specificity=rmyrocTsRm$specificities,Sensitivity=rmyrocTsRm$sensitivities,Model="RM"))
P4=ggplot(RavTsDF)+
geom_line(aes(Specificity,Sensitivity,colour = Model),linetype=2,linewidth = 1.5)+
