geom_abline(slope=1, intercept = 1,linewidth=1.2)+
theme_classic()+
scale_x_reverse()+
labs(title="Erijman (Random) Test Set")+
theme(axis.text = element_text(size=14,face = "bold",color="black"),axis.title=element_text(size=18,face="bold",color="black"),
legend.text = element_text(size=14,face = "bold",color="black"),legend.title=element_text(size=18,face="bold",color="black"),
legend.position = c(0.8,0.2),text = element_text(size=18,face = "bold",color="black"))
#Erkine Test Set
emyrocTsFm=roc(TsFmPredict[TsFmPredict$publication=="erkine",]$ADpos, TsFmPredict[TsFmPredict$publication=="erkine",]$Probability_Class_1)
emyrocTsNm=roc(TsNmPredict[TsNmPredict$publication=="erkine",]$ADpos, TsNmPredict[TsNmPredict$publication=="erkine",]$Probability_Class_1)
emyrocTsRm=roc(TsRmPredict[TsRmPredict$publication=="erkine",]$ADpos, TsRmPredict[TsRmPredict$publication=="erkine",]$Probability_Class_1)
ErkineTsDF=data.frame(Specificity=emyrocTsFm$specificities,Sensitivity=emyrocTsFm$sensitivities,Model="FM")
ErkineTsDF=rbind(ErkineTsDF,data.frame(Specificity=emyrocTsNm$specificities,Sensitivity=emyrocTsNm$sensitivities,Model="NM"))
ErkineTsDF=rbind(ErkineTsDF,data.frame(Specificity=emyrocTsRm$specificities,Sensitivity=emyrocTsRm$sensitivities,Model="RM"))
P3=ggplot(ErkineTsDF)+
geom_line(aes(Specificity,Sensitivity,colour = Model),linetype=2,linewidth = 1.5)+
scale_color_manual(name="Train Set",values = c("#FE4A49","#FED766","#009FB7"),breaks = c("FM","RM","NM"),labels=c("Full","Random","Natural"))+
geom_abline(slope=1, intercept = 1,linewidth=1.2)+
theme_classic()+
scale_x_reverse()+
labs(title="Cooper (Design) Test Set")+
