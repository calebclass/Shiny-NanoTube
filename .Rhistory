smyrocTsNm=roc(TsNmPredict[TsNmPredict$publication=="sanborn",]$ADpos, TsNmPredict[TsNmPredict$publication=="sanborn",]$Probability_Class_1)
smyrocTsRm=roc(TsRmPredict[TsRmPredict$publication=="sanborn",]$ADpos, TsRmPredict[TsRmPredict$publication=="sanborn",]$Probability_Class_1)
SanbornTsDF=data.frame(Specificity=smyrocTsFm$specificities,Sensitivity=smyrocTsFm$sensitivities,Model="FM")
SanbornTsDF=rbind(SanbornTsDF,data.frame(Specificity=smyrocTsNm$specificities,Sensitivity=smyrocTsNm$sensitivities,Model="NM"))
SanbornTsDF=rbind(SanbornTsDF,data.frame(Specificity=smyrocTsRm$specificities,Sensitivity=smyrocTsRm$sensitivities,Model="RM"))
P1=ggplot(SanbornTsDF)+
geom_line(aes(Specificity,Sensitivity,colour = Model),linetype=2,linewidth = 1.5)+
scale_color_manual(name="Train Set",values = c("#FE4A49","#FED766","#009FB7"),breaks = c("FM","RM","NM"),labels=c("Full","Random","Natural"))+
geom_abline(slope=1, intercept = 1,linewidth=1.2)+
theme_classic()+
scale_x_reverse()+
labs(title="Sanborn (Natural) Test Set")+
theme(axis.text = element_text(size=14,face = "bold",color="black"),axis.title=element_text(size=18,face="bold",color="black"),
legend.text = element_text(size=14,face = "bold",color="black"),legend.title=element_text(size=18,face="bold",color="black"),
